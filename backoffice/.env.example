# Copie este arquivo para .env e preencha os valores.

# Conexão do PostgreSQL
DATABASE_URL=postgres://usuario:senha@localhost:5432/equacao_abertura

# Chave longa e aleatória usada para assinar as sessões do painel
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio

# Porta do servidor e ambiente (use production em produção)
PORT=3000
NODE_ENV=development

# Primeiro administrador, criado pelo comando npm run seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
